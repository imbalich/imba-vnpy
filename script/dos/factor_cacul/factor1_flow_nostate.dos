/*
无状态因子计算
因子1：根据每一条最新报价，计算因子 (askVolume1-bidVolume1)/(askVolume1+bidVolume1)。
订阅tick_stream流表，实时计算因子值
*/

// 创建因子输出表
share table(1000000:0, `symbol`datetime`factorValue, [SYMBOL,TIMESTAMP,DOUBLE]) as factor1

// 定义因子处理函数
def factorHandler(mutable factor1, msg){
    x = select symbol, 
               datetime, 
               iif(ask_volume_1 + bid_volume_1 == 0, 0, (ask_volume_1 - bid_volume_1) / (ask_volume_1 + bid_volume_1)) as factorValue 
        from msg
    factor1.tableInsert(x)
}

// 订阅tick_stream流表
subscribeTable(tableName=`tick_stream, actionName="factor1_handler", handler=factorHandler{factor1}, msgAsTable=true)

print("✓ 已创建因子1订阅，实时计算因子值")
