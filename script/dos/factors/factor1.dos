// ============================================
// 因子1：买卖不平衡因子 (Imbalance)
// 订阅 tick_stream 流表，实时计算因子
// ============================================

// 1. 因子计算函数（无状态）
def imbalance(bid_volume_1, ask_volume_1){
    return iif(bid_volume_1 + ask_volume_1 == 0, 0, (bid_volume_1 - ask_volume_1) / (bid_volume_1 + ask_volume_1))
}

// 2. 清理旧的流计算引擎和订阅
def cleanImbalanceEngine(){
    // 取消订阅
    try{
        unsubscribeTable(tableName="tick_stream", actionName=`calc_imbalance)
    }catch(ex){}
    // 取消 Python 端可能的订阅
    try{
        unsubscribeTable(tableName="factor_imbalance_result", actionName=`python_factor_subscriber)
    }catch(ex){}
    // 删除引擎
    try{
        dropStreamEngine("imbalanceEngine")
    }catch(ex){}
    // 清理流表
    try{
        undef(`factor_imbalance_result, SHARED)
        dropStreamTable(`factor_imbalance_result)
    }catch(ex){}
    print("已清理旧资源")
}

// 3. 创建因子结果流表并共享
def createFactorResultTable(){
    // 注意：symbol 类型与 tick_stream 保持一致，使用 STRING
    t = streamTable(100000:0, `symbol`datetime`factorValue, [STRING, TIMESTAMP, DOUBLE])
    share(t, `factor_imbalance_result)
    return objByName(`factor_imbalance_result)
}

// 4. 创建流计算引擎
def createImbalanceEngine(outputTable){
    // 输入表结构（只需要计算所需的列）
    // 注意：symbol 类型必须与 tick_stream 一致，使用 STRING
    inputSchema = table(1:0, `symbol`datetime`bid_volume_1`ask_volume_1, [STRING, TIMESTAMP, DOUBLE, DOUBLE])
    
    // 定义计算指标：输出 datetime 和 因子值
    metrics = <[datetime, imbalance(bid_volume_1, ask_volume_1)]>
    
    // 创建响应式状态引擎
    engine = createReactiveStateEngine(
        name="imbalanceEngine",
        metrics=metrics,
        dummyTable=inputSchema,
        outputTable=outputTable,
        keyColumn="symbol"
    )
    return engine
}

// 5. 订阅流表
// 包装函数：筛选需要的列后再传给引擎
def imbalanceHandler(mutable msg){
    engine = getStreamEngine("imbalanceEngine")
    // 只选择引擎需要的列
    selectedData = select symbol, datetime, bid_volume_1, ask_volume_1 from msg
    engine.append!(selectedData)
}

def subscribeTickStream(){
    subscribeTable(
        tableName="tick_stream",
        actionName=`calc_imbalance,
        offset=-1,
        handler=imbalanceHandler,
        msgAsTable=true,
        batchSize=10,
        throttle=0.05
    )
    print("已订阅 tick_stream，实时计算因子")
}

// 6. 启动因子计算（主函数）
def startImbalanceFactor(){
    print("启动买卖不平衡因子计算...")
    
    // 清理旧资源
    cleanImbalanceEngine()
    
    // 创建输出表
    resultTable = createFactorResultTable()
    print("✓ 因子结果表已创建: factor_imbalance_result")
    
    // 创建引擎
    createImbalanceEngine(resultTable)
    print("✓ 流计算引擎已创建: imbalanceEngine")
    
    // 订阅流表
    subscribeTickStream()
    print("✓ 已订阅流表: tick_stream")
    
    print("因子计算已启动！")
    print("查看结果: select * from factor_imbalance_result")
}

// 7. 停止因子计算
def stopImbalanceFactor(){
    cleanImbalanceEngine()
    print("因子计算已停止")
}

// ============================================
// 执行：启动因子计算
// ============================================
startImbalanceFactor()