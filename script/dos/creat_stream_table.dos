// ============================================
// DolphinDB 流表创建脚本（修正版）
// 用于实时数据写入和订阅
// ============================================

// 1. 正确检查并删除已存在的流表（如果存在）
if(existsStreamTable(`tick_stream)) {
    dropStreamTable(`tick_stream)
}

// 2. 定义流表结构（与分区表结构一致，包括延迟字段）
colNames = `symbol`exchange`trade_date`datetime`name`last_price`open_price`high_price`low_price`pre_close`limit_up`limit_down`volume`last_volume`open_interest`bid_price_1`bid_volume_1`ask_price_1`ask_volume_1`gateway_name`receive_timestamp`write_start_timestamp`write_end_timestamp
// 注意：延迟分析字段应使用NANOTIMESTAMP（纳秒精度）
colTypes = [STRING, STRING, DATE, TIMESTAMP, STRING, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, DOUBLE, STRING, NANOTIMESTAMP, NANOTIMESTAMP, NANOTIMESTAMP]

// 3. 创建流表（预分配足够内存，100万行）
tick_stream = streamTable(1000000:0, colNames, colTypes)

// 4. 启用流表共享 - 两种方案选择其一

// 方案A：仅共享（推荐，简单可靠）
share(tick_stream, `tick_stream)

// 方案B：如果需要流表持久化（重启后数据不丢失），请先确保：
// - 在dolphindb.cfg中配置了 persistenceDir=/path/to/persistence
// - 服务器有该目录的写入权限
// enableTableShareAndPersistence(table=tick_stream, tableName=`tick_stream, cacheSize=100000, preCache=0)

// 5. 配置自动持久化到分区表
def saveToPartitionedTable(mutable t) {
    // 自动填充write_end_timestamp（如果未提供）
    if(size(t) > 0) {
        nullMask = isNull(t[`write_end_timestamp])
        if(any(nullMask)) {
            t[`write_end_timestamp][nullMask] = now(true)  // 纳秒精度当前时间
        }
    }
    
    // 写入到分区表
    tick_table = loadTable("dfs://vnpy_futures", "tick_data")
    tick_table.append!(t)
}

// 6. 先取消可能存在的旧订阅，避免重复订阅
try {
    unsubscribeTable(tableName=`tick_stream, actionName=`save_to_partitioned_table)
} catch(ex) {
    // 忽略错误，可能没有订阅
}

// 7. 创建新订阅
subscribeTable(
    tableName=`tick_stream, 
    actionName=`save_to_partitioned_table, 
    offset=-1, 
    handler=saveToPartitionedTable, 
    msgAsTable=true, 
    batchSize=100, 
    throttle=0.1
)

// 8. 验证流表创建成功
getStreamingStat().table

// 9. 输出创建成功信息
print("✓ 流表创建成功: tick_stream")
print("✓ 流表已启用共享")
print("✓ 已配置自动持久化到分区表")
print("✓ 延迟分析字段已正确设置为NANOTIMESTAMP类型")